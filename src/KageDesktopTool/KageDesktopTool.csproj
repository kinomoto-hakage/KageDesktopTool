<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Title>Kage 桌面工具</Title>
    <Version>1.1.0</Version>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets/app-d.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <Content Include="../../docs/使用说明.md" Link="使用说明.md" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../Kage.Workspace/Kage.Workspace.csproj" />
    <!-- 正式图标随源码维护，构建与发布均不依赖原型目录。 -->
    <Content Include="Assets/*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/app-a.png" />
    <Resource Include="Assets/app-b.png" />
    <Resource Include="Assets/app-c.png" />
    <Resource Include="Assets/app-d.png" />
  </ItemGroup>
</Project>
